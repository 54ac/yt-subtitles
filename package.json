{
	"name": "yt-subtitles",
	"author": {
		"name": "54ac",
		"email": "54acbio@gmail.com",
		"url": "https://github.com/54ac"
	},
	"repository": "github:54ac/yt-subtitles",
	"private": true,
	"version": "1.2.2",
	"type": "module",
	"scripts": {
		"start": "wxt -b firefox",
		"start:chrome": "wxt -b chrome",
		"build": "npm run build:firefox && npm run build:chrome",
		"build:firefox": "wxt build -b firefox",
		"build:chrome": "wxt build -b chrome",
		"clean": "wxt clean",
		"zip": "npm run zip:firefox && npm run zip:chrome",
		"zip:firefox": "wxt zip -b firefox",
		"zip:chrome": "wxt zip -b chrome",
		"compile": "tsc --noEmit",
		"postinstall": "wxt prepare"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@nabla/vite-plugin-eslint": "^3.0.1",
		"@types/chrome": "^0.3.4",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.0.0",
		"prettier": "^3.6.2",
		"stylelint": "^17.16.0",
		"stylelint-config-standard": "^40.0.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.45.0",
		"vite-plugin-stylelint": "6.0.4",
		"web-ext": "^10.7.0",
		"wxt": "^0.21.4"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"spawn-sync@1.0.15": true
	}
}
